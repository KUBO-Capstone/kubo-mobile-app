PORT=3000
NODE_ENV=development
# Signs login tokens (src/utils/token.ts). Any long random string; changing it logs everyone out.
AUTH_SECRET=change-me-to-a-long-random-string
# Market Watch: daily DA Bantay Presyo import (src/market/market-import.ts)
MARKET_IMPORT_ENABLED=true      # false = never scrape (offline demo, tests)
MARKET_IMPORT_HOUR=6            # local hour of the daily run
MARKET_IMPORT_ON_START=false    # true = also run right after the server boots
# BANTAY_PRESYO_BASE=http://www.bantaypresyo.da.gov.ph

AWS_REGION=
# Bucket for listing and profile photos (products/, profiles/). Required:
# the server keeps no photos on disk. Setup: docs/media_storage.md
S3_BUCKET=
# Optional public base for photos, e.g. https://dxxxx.cloudfront.net.
# Leave empty for a private bucket; the API then hands out presigned links.
MEDIA_BASE_URL=
DDB_MESSAGES_TABLE=

PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=