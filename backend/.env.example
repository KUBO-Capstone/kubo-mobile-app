PORT=3000
NODE_ENV=development
# Market Watch: daily DA Bantay Presyo import (src/market/market-import.ts)
MARKET_IMPORT_ENABLED=true      # false = never scrape (offline demo, tests)
MARKET_IMPORT_HOUR=6            # local hour of the daily run
MARKET_IMPORT_ON_START=false    # true = also run right after the server boots
# BANTAY_PRESYO_BASE=http://www.bantaypresyo.da.gov.ph
